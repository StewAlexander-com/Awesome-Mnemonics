#!/usr/bin/env python3
"""Run Awesome Mnemonics CLI. From repo: adds project root to path so mnemonic_cli is found."""
import os
import sys

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if root not in sys.path:
    sys.path.insert(0, root)

from mnemonic_cli.cli import main

main()
